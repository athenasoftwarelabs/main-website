# Google Sheets for contact form submissions (see README → "Contact form → Google Sheets").
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The service account's email, e.g. athena-website@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" value from the service account JSON key, kept on ONE line with \n escapes,
# wrapped in double quotes: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab name at the bottom of the sheet (optional, defaults to Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# Search engine verification (optional). Paste only the "content" value of the meta tag each tool gives you.
# Google Search Console: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=
